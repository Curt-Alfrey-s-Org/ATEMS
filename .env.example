# ATEMS environment template: copy to .env and fill in. PLACEHOLDERS ONLY; never commit real values.
# Required values are left empty on purpose: the app / docker compose refuse to start until they are set.
# See README.md "Security & required environment".

# --- Environment -------------------------------------------------------------
# production (default) | development | test
ENVIRONMENT=production
DEBUG=False

# --- Flask ---------------------------------------------------------------------
# REQUIRED. Long random string, e.g. output of: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database ------------------------------------------------------------------
# REQUIRED for Docker Compose (no fallback). Also used to build the DB URL inside compose.
POSTGRES_PASSWORD=
# REQUIRED when running without Docker (compose sets this itself). Examples:
#   SQLALCHEMY_DATABASE_URI=postgresql://atems_user:YOUR_DB_PASSWORD@127.0.0.1:5436/atems
#   SQLALCHEMY_DATABASE_URI=sqlite:///atems.db
SQLALCHEMY_DATABASE_URI=

# --- First admin / env logins (no defaults) ------------------------------------
# ADMIN_PASSWORD is REQUIRED on first boot against an empty database in production.
# Known defaults (admin123, user123, demo123, changeme123, ...) are rejected.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Optional env-based login with the 'user' role
USER_USERNAME=
USER_PASSWORD=

# --- Deployment ----------------------------------------------------------------
# Subpath when served under a prefix (e.g. /app/atems); empty for root
APPLICATION_ROOT=
# USE_PROXY_FIX=true
# GUNICORN_WORKERS=4

# --- Optional: email / calibration reminders ------------------------------------
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
# CALIBRATION_REMIND_DAYS=30
# CALIBRATION_REMIND_TO=
# REMIND_OVERDUE=true
# ATEMS_BASE_URL=http://127.0.0.1:5000

# --- Optional: performance -------------------------------------------------------
# ATEMS_PERF_LOG_THRESHOLD_MS=0
# ATEMS_DASHBOARD_PARALLEL=1
